# src/main/resources/graphql/schema.graphqls
type User {
    id: ID!
    username: String!
    roles: [String!]!
    fullName: String!
    email: String!
    phone: String
    status: String!
    createdAt: String! 
    updatedAt: String!
}

type Query {
    hello: String
    allUsers: [User]!
}

type Step {
  StepID: String
  titulo: String
  descripcion: String
  responsable: String
  metodo: String
  orden: Int
  tags: [String]
  createdAt: String
  updatedAt: String
  visible: Boolean
  deleted: Boolean
}

type Procedure {
  ProcedureID: String
  titulo: String
  descripcion: String
  responsable: String
  steps: [Step]
  createdAt: String
  updatedAt: String
  visible: Boolean
  deleted: Boolean
}

type Query {
  # STEPS
  getAllSteps: [Step]
  getStepByStepID(stepId: String!): Step
  searchStepsByResponsable(responsable: String!): [Step]
  searchStepsByTag(tag: String!): [Step]

  # PROCEDURES
  getAllProcedures: [Procedure]
  getProcedureByProcedureID(procedureId: String!): Procedure
  searchProceduresByTitulo(titulo: String!): [Procedure]
}