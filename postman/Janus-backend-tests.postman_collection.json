{
  "info": {
    "name": "Janus Backend Tests",
    "_postman_id": "b1f6c6d2-0000-4e00-8000-000000000000",
    "description": "Colección para probar endpoints de documentos (upload, update, delete, list, download)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "test-project",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Upload Document (POST /uploadDoc)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "idProyecto",
              "value": "{{projectId}}",
              "type": "text"
            },
            {
              "key": "documento",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/documentos/uploadDoc",
          "host": ["{{baseUrl}}"],
          "path": ["api","documentos","uploadDoc"]
        }
      }
    },
    {
      "name": "Update / Overwrite Document (PUT /updateFile)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "idProyecto", "value": "{{projectId}}", "type": "text" },
            { "key": "nombreArchivo", "value": "example.mp4", "type": "text" },
            { "key": "documento", "type": "file", "src": "" }
          ]
        },
        "url": { "raw": "{{baseUrl}}/api/documentos/updateFile", "host": ["{{baseUrl}}"], "path": ["api","documentos","updateFile"] }
      }
    },
    {
      "name": "Delete Document (DELETE /deleteFile)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documentos/deleteFile?idProyecto={{projectId}}&nombreArchivo=example.mp4",
          "host": ["{{baseUrl}}"],
          "path": ["api","documentos","deleteFile"],
          "query": [
            { "key": "idProyecto", "value": "{{projectId}}" },
            { "key": "nombreArchivo", "value": "example.mp4" }
          ]
        }
      }
    },
    {
      "name": "List Folders (GET /getAllFolders)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/documentos/getAllFolders", "host": ["{{baseUrl}}"], "path": ["api","documentos","getAllFolders"] }
      }
    },
    {
      "name": "List Files in Project (GET /getAllFiles)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documentos/getAllFiles?idProyecto={{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","documentos","getAllFiles"],
          "query": [ { "key": "idProyecto", "value": "{{projectId}}" } ]
        }
      }
    },
    {
      "name": "Get File Info (GET /getFileInfo)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documentos/getFileInfo?idProyecto={{projectId}}&nombreArchivo=example.mp4",
          "host": ["{{baseUrl}}"],
          "path": ["api","documentos","getFileInfo"],
          "query": [
            { "key": "idProyecto", "value": "{{projectId}}" },
            { "key": "nombreArchivo", "value": "example.mp4" }
          ]
        }
      }
    },
    {
      "name": "Get Folder Info (GET /getFolderInfo)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documentos/getFolderInfo?idProyecto={{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api","documentos","getFolderInfo"],
          "query": [ { "key": "idProyecto", "value": "{{projectId}}" } ]
        }
      }
    },
    {
      "name": "Download / Preview File (GET /getFile)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documentos/getFile?idProyecto={{projectId}}&nombreArchivo=example.mp4",
          "host": ["{{baseUrl}}"],
          "path": ["api","documentos","getFile"],
          "query": [
            { "key": "idProyecto", "value": "{{projectId}}" },
            { "key": "nombreArchivo", "value": "example.mp4" }
          ]
        }
      }
    }
  ]
}
