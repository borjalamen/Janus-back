### Gitignore for Java (Maven) project

## Maven / build
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildnumber.properties
/.mvn/wrapper/maven-wrapper.jar

## Compiled class files
**/*.class

## Logs
*.log
hs_err_pid*

## Temporary files
*.tmp
*.temp
tmp/
temp/

## IDEs and editors (ignore all generated files)
# IntelliJ / JetBrains
/.idea/
*.iml
*.iws

# Eclipse
.metadata/
.classpath
.project
.settings/

# NetBeans
/nbproject/

# Visual Studio Code
/.vscode/

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/

# Emacs
*~
\.#*
.emacs.desktop
.emacs.d/

# Vim
*.swp
*.swo

## OS generated files
.DS_Store
Thumbs.db
desktop.ini

## Docker
docker-compose.override.yml
Dockerfile*.local

## Certificate / secret artifacts
*.jks
*.keystore
*.pem
*.crt

## Others
# Ignore build output for this module and any nested modules
**/target/
.classpath
.factorypath
.project
.settings/

# Workspace document volume (not source)
volumenDocumentos/

### End of file
